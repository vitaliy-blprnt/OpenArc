+void BookmarkStorage::CommitPendingWrites(
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  // Preserve the normal backup, encryption and mirror paths. Force a fresh
+  // snapshot, including when an earlier write has already left the timer.
+  ScheduleSave();
+  writer_.RegisterOnNextWriteCallbacks(
+      base::OnceClosure(),
+      base::BindOnce(&PrimaryWriteCompletion::Complete,
+                     std::make_unique<PrimaryWriteCompletion>(
+                         std::move(callback))));
+  // This moves the registered callback into this write before returning, so a
+  // subsequent request cannot replace an earlier request's callback.
+  writer_.DoScheduledWrite();
 }
 
