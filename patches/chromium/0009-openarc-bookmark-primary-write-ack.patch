+void BookmarkModel::CommitPendingWrites(
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(callback);
+  if (!loaded_ || !local_or_syncable_store_ ||
+      (AreFoldersForAccountStorageAllowed() && !account_store_)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+
+  // Neither completion captures this model. Each store captures its snapshot
+  // synchronously and posts the primary result back to this sequence.
+  auto barrier = base::BarrierCallback<bool>(
+      account_store_ ? 2u : 1u,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> callback,
+             const std::vector<bool>& results) {
+            std::move(callback).Run(std::ranges::all_of(
+                results, [](bool success) { return success; }));
+          },
+          std::move(callback)));
+  local_or_syncable_store_->CommitPendingWrites(barrier);
+  if (account_store_) {
+    account_store_->CommitPendingWrites(barrier);
+  }
+}
