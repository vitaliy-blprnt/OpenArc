+// ImportantFileWriter drops its after-write callback if background serialization
+// fails. This owned guard reports that failure too, without retaining storage or
+// model pointers. BindPostTask keeps all completion invocations on the origin.
+class PrimaryWriteCompletion {
+ public:
+  explicit PrimaryWriteCompletion(base::OnceCallback<void(bool)> callback)
+      : callback_(base::BindPostTask(
+            base::SequencedTaskRunner::GetCurrentDefault(),
+            std::move(callback))) {}
+
+  ~PrimaryWriteCompletion() {
+    if (callback_) {
+      std::move(callback_).Run(false);
+    }
+  }
+
+  void Complete(bool success) { std::move(callback_).Run(success); }
+
+ private:
+  base::OnceCallback<void(bool)> callback_;
+};
 
