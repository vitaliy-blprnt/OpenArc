{
  "manifest_version": 3,
  "name": "OpenArc Platform Probe",
  "version": "0.3.0",
  "description": "User-triggered diagnostics for an isolated OpenArc development profile.",
  "minimum_chrome_version": "123",
  "permissions": ["tabs", "tabGroups", "storage", "bookmarks", "sessions", "scripting", "contextMenus", "sidePanel", "nativeMessaging"],
  "host_permissions": ["https://example.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "OpenArc Platform Probe", "default_popup": "popup.html"},
  "options_ui": {"page": "dashboard.html", "open_in_tab": true},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
